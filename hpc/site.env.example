# Copy this file to hpc/site.env on the cluster and edit the values for your
# site. Keep site.env private/local; it is intentionally ignored by Git.

# Shared project and environment paths.
export PROJECT_ROOT=/shared/path/to/alphagenome-SFT
# Put Conda environments, package archives, and pip downloads on scratch.
export SCRATCH_ROOT=/scratch/YOUR_NETID
# For Conda, set CONDA_ENV_NAME and leave ALPHAGENOME_ENV unset. For the
# existing venv flow, set ALPHAGENOME_ENV instead and leave CONDA_ENV_NAME unset.
export CONDA_ENV_NAME=aging-alphagenome
# export ALPHAGENOME_ENV=/shared/path/to/envs/alphagenome
export ALPHAGENOME_CACHE=/shared/path/to/cache/alphagenome
export PIP_CACHE_DIR="${SCRATCH_ROOT}/pip-cache"

# Shared data paths.
export REFERENCE_DIR=/shared/path/to/references/hg38
export HG38_FASTA="$REFERENCE_DIR/GRCh38.p13.genome.fa"
export OUTPUT_DIR=/shared/path/to/aging-project
export ALPHAGENOME_CHECKPOINT_DIR=/shared/path/to/weights/alphagenome-fold-0
# Do not put HF_TOKEN in this file. Enter it interactively only when running
# scripts/hpc/download_weights.py, then unset it.

# Slurm values. These are examples only; names differ by cluster.
export SLURM_ACCOUNT=YOUR_ACCOUNT
export CPU_PARTITION=YOUR_CPU_PARTITION
export GPU_PARTITION=YOUR_GPU_PARTITION

# Use cuda12 for pip-provided CUDA wheels. Use cuda12-local only if your site
# requires loading its own CUDA/cuDNN modules.
export JAX_CUDA_VARIANT=cuda12
